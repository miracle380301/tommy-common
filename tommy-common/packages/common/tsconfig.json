{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "noImplicitAny": false,
    "jsx": "react",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "frontend/**/*",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*",
    "stories/**/*"
  ]
}
