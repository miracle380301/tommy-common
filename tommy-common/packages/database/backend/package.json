{
  "name": "@miracle380301/database-service",
  "version": "1.0.1",
  "description": "Generic Database Service with Repository Pattern and CRUD Operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config examples/server.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/examples/server.js",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2"
  },
  "peerDependencies": {
    "mongoose": "^8.0.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-hstore": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miracle380301/tommy-common.git",
    "directory": "packages/database/backend"
  },
  "keywords": [
    "database",
    "orm",
    "adapter",
    "sqlite",
    "mongodb",
    "postgresql",
    "mysql",
    "sequelize",
    "mongoose",
    "repository-pattern"
  ],
  "author": "miracle380301",
